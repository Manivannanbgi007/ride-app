<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Checkstyle rules of every service (run by "mvnw verify"; a violation fails the build).

  The style the code already follows (4-space indent, at most 130 columns, import groups), plus the "Production coding
  rules" of the requirements that a source check can see: no System.out (rule 7), no catch (Exception) except where
  it is justified with @SuppressWarnings("checkstyle:IllegalCatch") (rule 12), and method names that say what they
  do (no process(), handle(), doSomething(), execute(): "Recommended naming").
  Layering rules (controllers, entities, repositories) are checked by each service's ArchitectureTest (ArchUnit).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- @SuppressWarnings("checkstyle:<check>") on a declaration, and the project-wide suppressions file -->
    <module name="SuppressWarningsFilter"/>
    <module name="SuppressionFilter">
        <property name="file" value="${checkstyle.suppressions.file}"/>
        <property name="optional" value="false"/>
    </module>

    <module name="FileTabCharacter"/>
    <module name="NewlineAtEndOfFile">
        <property name="lineSeparator" value="lf_cr_crlf"/>
    </module>
    <module name="LineLength">
        <property name="max" value="130"/>
        <property name="ignorePattern" value="^(package|import) .*|^\s*(\*|//).*https?://.*$"/>
    </module>
    <module name="RegexpSingleline">
        <property name="format" value="\s+$"/>
        <property name="message" value="Trailing whitespace"/>
    </module>

    <module name="TreeWalker">
        <module name="SuppressWarningsHolder"/>

        <!-- Names -->
        <module name="PackageName">
            <property name="format" value="^com\.fooddelivery(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="TypeName"/>
        <module name="MethodName">
            <!-- Requirements, "Recommended naming": the name should say what the method does -->
            <property name="format" value="^(?!(process|handle|doSomething|execute)$)[a-z][a-zA-Z0-9]*$"/>
            <message key="name.invalidPattern"
                     value="Method name ''{0}'': use a name that says what it does (not process, handle, doSomething or execute)."/>
        </module>
        <module name="ConstantName">
            <property name="format" value="^log$|^[A-Z][A-Z0-9]*(_[A-Z0-9]+)*$"/>
        </module>
        <module name="StaticVariableName"/>
        <module name="MemberName"/>
        <module name="ParameterName"/>
        <module name="LambdaParameterName"/>
        <module name="CatchParameterName"/>
        <module name="LocalVariableName"/>
        <module name="LocalFinalVariableName"/>
        <module name="PatternVariableName"/>
        <module name="RecordComponentName"/>
        <module name="ClassTypeParameterName">
            <property name="format" value="^[A-Z][0-9]?$"/>
        </module>
        <module name="MethodTypeParameterName">
            <property name="format" value="^[A-Z][0-9]?$"/>
        </module>

        <!-- Imports: static, then java, then the rest, alphabetical, a blank line between the groups -->
        <module name="AvoidStarImport"/>
        <module name="RedundantImport"/>
        <module name="UnusedImports"/>
        <module name="IllegalImport">
            <!-- java.time instead of Date/Calendar; entities never use @Data (equals/hashCode over lazy state) -->
            <property name="illegalPkgs" value="sun, org.joda.time"/>
            <property name="illegalClasses"
                      value="java.util.Date, java.util.Calendar, java.text.SimpleDateFormat, lombok.Data, lombok.SneakyThrows"/>
        </module>
        <module name="CustomImportOrder">
            <property name="customImportOrderRules" value="STATIC###STANDARD_JAVA_PACKAGE###THIRD_PARTY_PACKAGE"/>
            <property name="standardPackageRegExp" value="^(java|javax)\."/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <!-- Blocks and braces -->
        <module name="NeedBraces"/>
        <module name="LeftCurly"/>
        <module name="RightCurly"/>
        <module name="AvoidNestedBlocks">
            <property name="allowInSwitchCase" value="true"/>
        </module>
        <module name="EmptyBlock">
            <property name="option" value="text"/>
        </module>
        <module name="EmptyCatchBlock">
            <property name="exceptionVariableName" value="expected|ignored"/>
        </module>

        <!-- Coding -->
        <module name="IllegalCatch">
            <!-- Requirements rule 12: no catch (Exception) everywhere. Justify the few with @SuppressWarnings -->
            <property name="illegalClassNames" value="Exception, Throwable, RuntimeException, Error"/>
        </module>
        <module name="EqualsHashCode"/>
        <module name="CovariantEquals"/>
        <module name="StringLiteralEquality"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="EmptyStatement"/>
        <module name="FallThrough"/>
        <module name="ModifiedControlVariable"/>
        <module name="NoFinalizer"/>
        <module name="IllegalInstantiation">
            <property name="classes" value="java.lang.Boolean, java.lang.Integer, java.lang.Long"/>
        </module>
        <module name="UnnecessarySemicolonInEnumeration"/>
        <module name="UnnecessarySemicolonInTryWithResources"/>
        <module name="UnnecessarySemicolonAfterTypeMemberDeclaration"/>
        <module name="ParameterNumber">
            <property name="max" value="10"/>
            <property name="ignoreOverriddenMethods" value="true"/>
            <property name="tokens" value="METHOD_DEF"/>
        </module>
        <module name="RegexpSinglelineJava">
            <!-- Requirements rule 7: no System.out.println(); log instead -->
            <property name="format" value="System\.(out|err)\.|\.printStackTrace\(\)"/>
            <property name="ignoreComments" value="true"/>
            <property name="message" value="Use the logger, not System.out/System.err/printStackTrace()"/>
        </module>

        <!-- Class design -->
        <module name="FinalClass"/>
        <module name="HideUtilityClassConstructor"/>
        <module name="OneTopLevelClass"/>
        <module name="OuterTypeFilename"/>
        <module name="InterfaceIsType"/>
        <module name="VisibilityModifier">
            <property name="packageAllowed" value="true"/>
            <property name="protectedAllowed" value="true"/>
        </module>
        <module name="MutableException"/>

        <!-- Modifiers and misc -->
        <module name="ModifierOrder"/>
        <module name="RedundantModifier"/>
        <module name="UpperEll"/>
        <module name="ArrayTypeStyle"/>
        <module name="AvoidEscapedUnicodeCharacters">
            <property name="allowEscapesForControlCharacters" value="true"/>
            <property name="allowByTailComment" value="true"/>
            <property name="allowNonPrintableEscapes" value="true"/>
        </module>

        <!-- Whitespace -->
        <module name="WhitespaceAround">
            <property name="allowEmptyConstructors" value="true"/>
            <property name="allowEmptyMethods" value="true"/>
            <property name="allowEmptyTypes" value="true"/>
            <property name="allowEmptyLoops" value="true"/>
            <property name="allowEmptyLambdas" value="true"/>
            <property name="allowEmptySwitchBlockStatements" value="true"/>
        </module>
        <module name="WhitespaceAfter"/>
        <module name="NoWhitespaceBefore"/>
        <module name="NoWhitespaceAfter"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="GenericWhitespace"/>
        <module name="TypecastParenPad"/>
        <module name="SingleSpaceSeparator"/>
        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
            <property name="allowMultipleEmptyLinesInsideClassMembers" value="false"/>
        </module>
        <module name="Indentation">
            <property name="basicOffset" value="4"/>
            <property name="caseIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <!-- Continuation lines of annotation arrays (properties = {...}) are indented 8, like other wrapped lines -->
            <property name="arrayInitIndent" value="8"/>
            <property name="forceStrictCondition" value="false"/>
        </module>

        <!-- Comments -->
        <module name="InvalidJavadocPosition"/>
        <module name="JavadocMissingWhitespaceAfterAsterisk"/>
        <module name="NonEmptyAtclauseDescription"/>
        <module name="TodoComment">
            <property name="format" value="(TODO|FIXME)"/>
            <property name="severity" value="warning"/>
        </module>
    </module>
</module>

{
  "dynamic": "strict",
  "properties": {
    "id": { "type": "long" },
    "name": {
      "type": "text", "analyzer": "folded",
      "fields": {
        "autocomplete": { "type": "text", "analyzer": "autocomplete", "search_analyzer": "folded" },
        "sort": { "type": "keyword", "normalizer": "folded" }
      }
    },
    "description": { "type": "text", "analyzer": "folded" },
    "price": { "type": "scaled_float", "scaling_factor": 100 },
    "foodType": { "type": "keyword" },
    "imageUrl": { "type": "keyword", "index": false },
    "available": { "type": "boolean" },
    "status": { "type": "keyword" },
    "categoryId": { "type": "long" },
    "categoryName": {
      "type": "text", "analyzer": "folded",
      "fields": { "raw": { "type": "keyword" } }
    },
    "restaurantId": { "type": "long" },
    "restaurantName": { "type": "text", "analyzer": "folded" },
    "restaurantCity": { "type": "keyword" },
    "restaurantStatus": { "type": "keyword" },
    "ratingAverage": { "type": "double" },
    "ratingCount": { "type": "integer" },
    "sourceVersion": { "type": "long" },
    "indexedAt": { "type": "date" }
  }
}

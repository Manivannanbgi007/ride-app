package com.fooddelivery.searchservice.controller;

import com.fooddelivery.searchservice.dto.response.IndexOverview;
import com.fooddelivery.searchservice.dto.response.ConsistencyReport;
import com.fooddelivery.searchservice.dto.response.RatingSyncResult;
import com.fooddelivery.searchservice.dto.response.RepairResult;
import com.fooddelivery.searchservice.service.ConsistencyService;
import com.fooddelivery.searchservice.service.IndexOverviewService;
import com.fooddelivery.searchservice.service.RatingSyncService;
import com.fooddelivery.searchservice.web.CallerInfo;
import io.swagger.v3.oas.annotations.Operation;
import io.swagger.v3.oas.annotations.tags.Tag;
import lombok.RequiredArgsConstructor;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.PostMapping;
import org.springframework.web.bind.annotation.RequestMapping;
import org.springframework.web.bind.annotation.RestController;

@Tag(name = "Admin: search", description = "Search index health (PLATFORM_ADMIN)")
@RestController
@RequestMapping("/api/v1/admin/search")
@RequiredArgsConstructor
public class AdminSearchController {

    private final IndexOverviewService indexOverviewService;
    private final ConsistencyService consistencyService;
    private final RatingSyncService ratingSyncService;

    @Operation(summary = "Elasticsearch health and the number of documents in each index",
            description = "To fill or rebuild the indexes from MySQL, republish the events: "
                    + "POST /api/v1/admin/restaurants/events/republish, /api/v1/admin/categories/events/republish "
                    + "and /api/v1/admin/menu-items/events/republish")
    @GetMapping("/indexes")
    public IndexOverview getIndexes() {
        return indexOverviewService.getOverview();
    }

    @Operation(summary = "Compare every index with MySQL (the truth) and list what differs",
            description = "Missing (in MySQL, not in the index), stale (index older), ahead (index newer, e.g. after a "
                    + "database restore) and orphans (in the index, no longer in MySQL). Changes nothing; 503 if an "
                    + "owning service cannot be reached.")
    @GetMapping("/consistency")
    public ConsistencyReport getConsistency() {
        return consistencyService.check();
    }

    @Operation(summary = "Repair the indexes from MySQL",
            description = "Removes orphans and documents that are ahead, and asks restaurant-service and catalog-service "
                    + "to publish the affected data again (their own audited actions, as you). The index catches up "
                    + "within seconds: check again afterwards. Nothing is written to MySQL.")
    @PostMapping("/consistency/repair")
    public RepairResult repair(CallerInfo caller) {
        return consistencyService.repair(caller);
    }

    @Operation(summary = "Copy the ratings from review-service into the search indexes now",
            description = "The same run that happens every minute: pulls the average and number of ratings of every "
                    + "rated restaurant and dish from review-service and writes them into the indexes (only those two "
                    + "fields, only documents that exist). Documents whose reviews are all gone go back to \"no "
                    + "ratings\". Answers with how many documents were updated and reset; 503 if review-service "
                    + "cannot be reached (nothing is changed then).")
    @PostMapping("/ratings/sync")
    public RatingSyncResult syncRatings() {
        return ratingSyncService.sync();
    }
}

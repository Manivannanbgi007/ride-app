# Copy this file to .env and change the values.
# .env is git-ignored. Never commit real passwords.

# ---------- MySQL ----------
# Host port for the Docker MySQL (3330 avoids clashing with other MySQL instances).
MYSQL_PORT=3330
MYSQL_ROOT_PASSWORD=change-me-root

# One database user per service (database-per-service rule).
USER_DB_PASSWORD=change-me-user
RESTAURANT_DB_PASSWORD=change-me-restaurant
CATALOG_DB_PASSWORD=change-me-catalog
ORDER_DB_PASSWORD=change-me-order
PAYMENT_DB_PASSWORD=change-me-payment
NOTIFICATION_DB_PASSWORD=change-me-notification
DELIVERY_DB_PASSWORD=change-me-delivery
DELIVERY_PARTNER_DB_PASSWORD=change-me-delivery-partner
PROMOTION_DB_PASSWORD=change-me-promotion
ADMIN_DB_PASSWORD=change-me-admin
REVIEW_DB_PASSWORD=change-me-review
CHAT_DB_PASSWORD=change-me-chat

# ---------- User Service ----------
# First PLATFORM_ADMIN, created at startup if it does not exist yet.
BOOTSTRAP_ADMIN_EMAIL=admin@fooddelivery.local
BOOTSTRAP_ADMIN_PASSWORD=ChangeMe123

# RSA private key that signs access tokens (JWT): base64 of a PKCS#8 key, 2048 bits or more, on ONE line.
# Generate it once (Git Bash):  openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -outform DER | base64 -w0
# Empty in local development: user-service then makes a temporary key at every start (signed-in users are refreshed
# automatically). Required everywhere else. Never commit a real key.
JWT_PRIVATE_KEY=

# Shared secret the services send each other on their internal APIs (/api/v1/internal/**, header X-Service-Token).
# Any long random text, the same for every service (they all read this file); generate one with:
# openssl rand -base64 32. Leave the line out locally to use the dev profile's value; required everywhere else.
INTERNAL_SERVICE_TOKEN=change-me-internal-service-token

# ---------- API Gateway ----------
CORS_ALLOWED_ORIGINS=http://localhost:5180

# ---------- Payment Service: online payments ----------
# SIMULATED = built-in test gateway (no keys, no real money; the default)
# RAZORPAY  = Razorpay Checkout. Keys: Razorpay Dashboard -> switch to Test Mode -> Account & Settings -> API Keys.
#             Test Mode keys start with rzp_test_ and never move real money. The key secret stays on the server;
#             only the key id is sent to the browser.
PAYMENT_PROVIDER=SIMULATED
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type when adding the webhook (Dashboard -> Account & Settings -> Webhooks); any long random text
RAZORPAY_WEBHOOK_SECRET=
# Shown at the top of Razorpay Checkout
RAZORPAY_MERCHANT_NAME=Front-App

# ---------- Grafana (observability) ----------
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# ---------- SonarQube (code quality, profile "quality") ----------
SONARQUBE_DB_PASSWORD=change-me-sonarqube-db
# Set on SonarQube's first start by quality/sonar-scan.ps1 (SonarQube's rule: 12+ characters with upper and
# lower case letters, a digit and a special character)
SONARQUBE_ADMIN_PASSWORD=Change-Me-Sonar-1

# Debezium (profile "cdc"): read-only MySQL user for the binary log
DEBEZIUM_DB_PASSWORD=change-me-debezium

# AI assistant (profile "ai")
OLLAMA_MODEL=qwen3:4b-instruct-2507-q4_K_M
OLLAMA_KEEP_ALIVE=30m
# Shared secret between ai-mcp-client and ai-mcp-server. Use a long random value outside local development.
AI_SERVICE_TOKEN=change-me-ai-service-token
OLLAMA_MEMORY_LIMIT=10g

# Host port of user-service (default 8081); change it when another program on the machine holds 8081
# USER_SERVICE_HOST_PORT=8081

# ---------- Ports on this machine ----------
# Another project already uses the platform's ports (Kafka 9092, Redis 6379, Elasticsearch 9200, the gateway 8080...)?
# start-local.ps1 then names the port and the program and starts nothing. Move every port of the platform at once
# (services, web app, infrastructure), e.g. by 10000: gateway http://localhost:18080, web app 15180, Kafka 19092:
# FD_PORT_OFFSET=10000
# Or single infrastructure ports (docker compose reads them too; start-local.ps1 uses a value set here as it is and
# tells the services; a service started another way, e.g. from the IDE, needs KAFKA_BOOTSTRAP_SERVERS and so on):
# KAFKA_HOST_PORT=9092
# SCHEMA_REGISTRY_HOST_PORT=8091
# REDIS_HOST_PORT=6379
# ELASTICSEARCH_HOST_PORT=9200
# MAILPIT_HOST_PORT=8025
# MAILPIT_SMTP_HOST_PORT=1025
# PHPMYADMIN_HOST_PORT=8095
# OLLAMA_HOST_PORT=11434

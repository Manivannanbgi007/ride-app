# Settings shared by every environment. Each environment's own file overrides them:
#   .env.development (npm run dev)   .env.demo (build:demo)   .env.uat (build:uat)
#   .env.preprod (build:preprod)     .env.production (build / build:production)
# Personal overrides go in .env.local (never committed).
#
# Only variables starting with VITE_ reach the application, and they end up in the JavaScript every visitor
# downloads: never put a password, key or token in these files.

VITE_APP_NAME=Front-App

# Milliseconds before a request is given up. Above the API Gateway's own limit (10 s), so the gateway's clearer
# answer (504 "did not answer in time") arrives first.
VITE_API_TIMEOUT_MS=15000

# Feature flags (true / false)
#   API_LOGGING        log every API request and answer in the browser console
#   QUERY_DEVTOOLS     the React Query devtools panel (cached API data); never part of production builds
#   ENVIRONMENT_BADGE  show the environment's name in the header, so nobody mistakes UAT for production
#   PAYMENT_TEST_HINTS show the simulated payment provider's test cards and UPI ids on the payment page
#   LIVE_UPDATES       live updates over a WebSocket (through the API Gateway): orders, deliveries and the dashboard
#                      change without a refresh. Off: pages refresh by their own timers only.
VITE_FEATURE_API_LOGGING=false
VITE_FEATURE_QUERY_DEVTOOLS=false
VITE_FEATURE_ENVIRONMENT_BADGE=true
VITE_FEATURE_PAYMENT_TEST_HINTS=true
VITE_FEATURE_LIVE_UPDATES=true
#   FAKE_LIVE_TRACKING the live map of an order (/customer/orders/:id/track) shows a labelled sample ride instead of the
#                      partner's real GPS position (delivery-service GET /api/v1/delivery/orders/{orderId}/live).
#                      For demonstrations without a phone on the road only; the status, timing, partner and address
#                      still come from the order's real delivery.
VITE_FEATURE_FAKE_LIVE_TRACKING=false
#   DEV_ACCOUNTS       the local platform's test accounts under every sign-in form: one click signs in. npm run dev
#                      only: a build never contains them, even with the flag on (their passwords stay out of the
#                      JavaScript visitors download). The list: src/components/business/Auth/DevAccountsPanel.tsx
VITE_FEATURE_DEV_ACCOUNTS=false

# The live map of an order (Leaflet): no key, no account. Empty = OpenStreetMap's own tile servers, which are free
# but meant for light use only (https://operations.osmfoundation.org/policies/tiles/). A busy production site points
# these at its own or a paid {z}/{x}/{y} tile server, with the credit that provider requires (HTML).
VITE_MAP_TILE_URL=
VITE_MAP_TILE_ATTRIBUTION=


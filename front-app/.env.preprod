# Pre-production: npm run build:preprod. Replace the URL with the pre-production API Gateway.
# No temporary identity: pre-production behaves like production (real login comes with the security phase).
VITE_APP_ENV=Pre-Production
VITE_API_BASE_URL=https://preprod-api.fooddelivery.example.com

VITE_FEATURE_PAYMENT_TEST_HINTS=false

# Never a simulated ride for real customers
VITE_FEATURE_FAKE_LIVE_TRACKING=false

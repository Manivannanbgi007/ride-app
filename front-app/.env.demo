# Demo: npm run build:demo. Replace the URL with the demo environment's API Gateway.
VITE_APP_ENV=Demo
VITE_API_BASE_URL=https://demo-api.fooddelivery.example.com
# A labelled sample ride on the tracking map: a demo has no partner riding with a phone (see .env)
VITE_FEATURE_FAKE_LIVE_TRACKING=true


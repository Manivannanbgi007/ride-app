# Development: npm run dev, against the platform on this machine (start-local.ps1 or docker compose)
VITE_APP_ENV=Development
VITE_API_BASE_URL=http://localhost:8080

VITE_FEATURE_API_LOGGING=true
VITE_FEATURE_QUERY_DEVTOOLS=true
# The test accounts under the sign-in forms (see .env); false in .env.development.local hides them
VITE_FEATURE_DEV_ACCOUNTS=true


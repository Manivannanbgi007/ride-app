# Production: npm run build (or build:production). Replace the URL with the production API Gateway.
# No temporary identity in production (real login comes with the security phase).
VITE_APP_ENV=Production
VITE_API_BASE_URL=https://api.fooddelivery.example.com

VITE_FEATURE_ENVIRONMENT_BADGE=false
VITE_FEATURE_PAYMENT_TEST_HINTS=false

# Never a simulated ride for real customers
VITE_FEATURE_FAKE_LIVE_TRACKING=false
